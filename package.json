{
  "name": "offscreen-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, free studio that turns a short script file into a vertical 3D cartoon short.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "tsx pipeline/cli.ts render",
    "new": "tsx pipeline/cli.ts new",
    "queue": "tsx pipeline/cli.ts queue",
    "prepare-ep": "tsx pipeline/cli.ts prepare",
    "doctor": "tsx pipeline/cli.ts doctor",
    "voices": "tsx pipeline/cli.ts voices",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.546",
    "@remotion/cli": "4.0.546",
    "@remotion/renderer": "4.0.546",
    "@remotion/three": "4.0.546",
    "kokoro-js": "1.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.546",
    "three": "0.180.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/react": "19.2.2",
    "@types/three": "0.180.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
